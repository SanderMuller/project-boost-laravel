includes:
    - phpstan-baseline.neon
    - phar://phpstan.phar/conf/bleedingEdge.neon
    - vendor/spaze/phpstan-disallowed-calls/disallowed-dangerous-calls.neon
    - vendor/spaze/phpstan-disallowed-calls/disallowed-execution-calls.neon
    - vendor/spaze/phpstan-disallowed-calls/disallowed-insecure-calls.neon

parameters:
    tmpDir: .cache/phpstan

    paths:
        - src
        - tests
        - workbench

    level: max

    strictRules:
        allRules: true

    editorUrl: 'phpstorm://open?file=%%file%%&line=%%line%%'

    type_coverage:
        return: 100
        param: 100
        property: 100
        constant: 0
        declare: 100

    type_perfect:
        null_over_false: true
        narrow_return: true

    cognitive_complexity:
        class: 80
        function: 20

    treatPhpDocTypesAsCertain: false

    ignoreErrors:
        -
            identifier: trait.unused
            reportUnmatched: false
        # Pest's expectation API is marked @internal but is the intended public
        # surface for tests. Allow calling it from our tests/.
        -
            identifier: method.internalClass
            paths:
                - tests/*
            reportUnmatched: false
        # This package's OWN @internal classes (the Discovery readers/gate/
        # manifest/resolver, BoostWrapper, …) are legitimately exercised by its
        # own tests. The tests live in the global Pest namespace, so the
        # internalClass rule fires across the SanderMuller root boundary — but a
        # package testing its own internals is not a real violation. Scoped to
        # tests/ so a genuine cross-package @internal access in src/ still fails.
        -
            identifier: new.internalClass
            paths:
                - tests/*
            reportUnmatched: false
        -
            identifier: staticMethod.internalClass
            paths:
                - tests/*
            reportUnmatched: false
        -
            identifier: classConstant.internalClass
            paths:
                - tests/*
            reportUnmatched: false
        # Same rationale for this package's own @internal ENUMS (e.g.
        # Reconcile\ReconcileStatus): the cases are referenced from our own
        # tests, which live in the global Pest namespace, so the rule fires
        # across the SanderMuller root boundary. Scoped to tests/.
        -
            identifier: classConstant.internalEnum
            paths:
                - tests/*
            reportUnmatched: false
        -
            identifier: property.internalClass
            paths:
                - tests/*
            reportUnmatched: false
        -
            identifier: parameter.internalClass
            paths:
                - tests/*
            reportUnmatched: false
        -
            identifier: return.internalClass
            paths:
                - tests/*
            reportUnmatched: false
        # Pest binds test closures' `$this` to the configured TestCase at
        # runtime, but phpstan sees `$this` as `Pest\PendingCalls\TestCall`
        # for static analysis. Two narrow regexes catch only this specific
        # binding shape — typos against any other receiver, and undefined
        # methods Pest's TestCall genuinely lacks, still fail.
        #
        # 1. `$this->artisan(...)` and a closed allowlist of Laravel
        #    TestCase methods we actually call from Pest feature tests.
        #    A typo like `$this->artisanX(...)` wouldn't match this regex
        #    and would still fail — phpstan tells us, we widen the list
        #    deliberately when adding a new test method.
        # 2. Chained assertions on the artisan-result PendingCommand
        #    (`->expectsOutput…`, `->assert…`, `->dontExpect…`,
        #    `->doesntExpect…`, `->withoutMockingConsoleOutput`): phpstan
        #    types the receiver as `mixed` after step 1's suppression, so
        #    we match the specific Laravel testing method-name prefixes
        #    on mixed.
        -
            message: '#Call to an undefined method Pest\\PendingCalls\\TestCall::(artisan|withoutMockingConsoleOutput|expectException|expectExceptionMessage)\(\)#'
            paths:
                - tests/Feature/*
            reportUnmatched: false
        -
            message: '#Cannot call method (expects|assert|dontExpect|doesntExpect|withoutMockingConsoleOutput)\w*\(\) on mixed#'
            paths:
                - tests/Feature/*
            reportUnmatched: false
